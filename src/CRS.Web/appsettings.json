{
  "Logging": {
    "LogLevel": {
      "Default": "#{Logging.LogLevel.Default}#",
      "Microsoft.AspNetCore": "#{Logging.LogLevel.Microsoft.AspNetCore}#"
    },
    "Directory": "#{Logging.Directory}#"
  },
  "AllowedHosts": "#{AllowedHosts}#",
  "CallApi": {
    "BaseUrl": "#{CallApi.BaseUrl}#",
    "Debug": "#{CallApi.Debug}#",
    "DebugExtension": "#{CallApi.DebugExtension}#",
    "DebugDate": "#{CallApi.DebugDate}#"
  },
  "Smtp": {
    "Host": "#{Smtp.Host}#",
    "Port": "#{Smtp.Port}#",
    "From": "#{Smtp.From}#",
    "HelpDesk": "#{Smtp.HelpDesk}#",
    "Username": "#{Smtp.Username}#",
    "Password": "#{Smtp.Password}#",
    "EnableSsl": "#{Smtp.EnableSsl}#",
    "TimeoutSeconds": "#{Smtp.TimeoutSeconds}#",
    "DebugEmail": "#{Smtp.DebugEmail}#",
    "DebugEmailAddress": "#{Smtp.DebugEmailAddress}#",
    "AE_Email_Send_To": "#{Smtp.AE_Email_Send_To}#"
  },
  "ConnectionStrings": {
    "CallRating": "#{ConnectionStrings.CallRating}#",
    "Users": "#{ConnectionStrings.Users}#"
  },
  "AzureAd": {
    "Instance": "#{AzureAd.Instance}#",
    "Domain": "#{AzureAd.Domain}#",
    "ClientId": "#{AzureAd.ClientId}#",
    "TenantId": "#{AzureAd.TenantId}#",
    "ClientSecret": "#{AzureAd.ClientSecret}#",
    "CallbackPath": "#{AzureAd.CallbackPath}#",
    "SignedOutCallbackPath": "#{AzureAd.SignedOutCallbackPath}#",
    "PostLogoutRedirectUri": "#{AzureAd.PostLogoutRedirectUri}#"
  },
  "ReverseProxy": {
    "TrustedProxies": [
      "#{ReverseProxy.TrustedProxies}#"
    ],
    "TrustedNetworks": [
      "#{ReverseProxy.TrustedNetworks}#"
    ],
    "ForwardLimit": "#{ReverseProxy.ForwardLimit}#"
  }
}
