<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Call Rating System</title>
    <link rel="icon" type="image/png" href="~/images/hw-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/legacy/main.css" asp-append-version="true" />
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
    { <link rel="stylesheet" href="~/legacy/admin.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="crs-app">
    <header><nav class="nav_bar" aria-label="Main navigation">
        <a asp-controller="CallList" asp-action="Index" class="HW_Logo"><img src="~/images/hw-logo.png" alt="Health Window" /></a>
        <div class="System_name"><a class="navbar-brand" asp-controller="CallList" asp-action="Index">Call Rating System</a></div>
        <button type="button" class="menu-toggle hw-btn" aria-controls="navigation-links" aria-expanded="false">Menu</button>
        <div class="navigation-links" id="navigation-links"><div class="nav_bar--items">
            <a class="hw-btn secondary-button" asp-controller="CallList" asp-action="Index">My calls</a>
            <a class="hw-btn secondary-button" asp-controller="Admin" asp-action="Index">Help desk</a>
        </div></div>
    </nav></header>
    <main class="container-fluid app-content" id="main-content">
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["Warning"] is string warning) { <div class="alert alert-warning" role="status">@warning</div> }
        @RenderBody()
    </main>
    <footer class="app-footer">Call Rating System</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
