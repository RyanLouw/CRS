<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.master.cs" Inherits="CallRatingSystem.MasterPages.Main" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>CallRatingSystem</title>
    <meta name="viewport" content="initial-scale=1, user-scalable=no">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="Call Rating System Website">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="format-detection" content="telephone=no">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="icon" type="image/png" sizes="16x16" href="../Images/HW Logo cross-colour.png">    

    <script src="../Scripts/jqueryHW.min.js"></script>
    <script src="../Scripts/bootstrap.min.js"></script>
    <script src="../Scripts/Custom/HWValidation.js"></script>


    <link href="../Content/bootstrap.min.css" rel="stylesheet" />
    <link href="../Content/main.css" rel="stylesheet" />

    <script src="../Content/MovableModal/jquery-ui.min.js"></script>


</head>
<body>
    <form id="form1" runat="server">
        <nav class="nav_bar">
            <div class="HW_Logo">
                <img src="../Images/HW Logo- Colour-3.png" alt="Logo" />
            </div>
            <div class="System_name">
                <a class="navbar-brand" href="CallList.aspx">Call Rating System</a>
            </div>
            <div class="burger-container">
                <div id="burger">
                    <div class="bar topBar"></div>
                    <div class="bar btmBar"></div>
                </div>
            </div>
            <div class="nav_bar--items" id="navbarSupportedContent">
                <ul class="isHidden">
                    <li>
                        <a href="CallList.aspx"><span class="sr-only">(current)</span></a>
                    </li>
                </ul>
                <div class="nav_bar--items">
                    <div class="nav_bar--item">
                        <a runat="server" id="lkAdmin" onclick="AdminRedirect();">Admin</a>
                    </div>
                    <div class="nav_bar--item">
                        <a onclick="Logout();">Log Out</a>
                    </div>

                </div>
            </div>
        </nav>

        <asp:Button runat="server" ID="btnAdmin" OnClick="btnAdmin_Click" Style="display: none" />
        <asp:Button runat="server" ID="btnLogout" OnClick="btnLogout_Click" Style="display: none" />
        <br />
        <div class="container-fluid">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <script type="text/javascript">

        function Logout() {
            $("#<%=btnLogout.ClientID%>").click();
        }
        function AdminRedirect() {
            $("#<%=btnAdmin.ClientID%>").click();
        }

        $('.modal-dialog').draggable({
            handle: ".modal-header"
        });

        (function () {
            var burger = document.querySelector('.burger-container'),
                headerParent = document.querySelector('.nav_bar--items');
                header = document.querySelector('.nav_bar--items > .nav_bar--items');

            burger.onclick = function () {
                headerParent.classList.toggle('menu-opened');
                header.classList.toggle('menu-opened');
            }
        }());

    </script>

</body>
</html>

