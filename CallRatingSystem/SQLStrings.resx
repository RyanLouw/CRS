  <data name="CallQuery" xml:space="preserve">
    <value>SELECT TOP 20 
    CallDateTime AS "Call Time",
    CallerNumber AS "Number Dialed",
    CallID AS call_id,
    RecordingID
FROM [UN_Pabx].[dbo].[Rep_PABX_Daily_Logs]
WHERE RecordingID IS NOT NULL
and  Extension = @Ext
ORDER BY CallDateTime DESC;</value>
  </data>
  <data name="CallQueryOld" xml:space="preserve">
    <value>SELECT ch.start_time as "Call Time", ch.party_name AS "Number Dialed", ch.call_id
FROM myphone_callhistory_v14 ch
WHERE ch.dnowner = @Ext
ORDER BY ch.start_time DESC
limit 10</value>
  </data>
  <data name="CallQueryPSP" xml:space="preserve">
    <value>SELECT TOP 100 
    CallDateTime AS "Call Time",
    CallerNumber AS "Number Dialed",
    CallID AS call_id,
    RecordingID
FROM [UN_Pabx].[dbo].[Rep_PABX_Daily_Logs]
WHERE Extension = @Ext
ORDER BY CallDateTime DESC;
</value>
  </data>
  <data name="DownloadCallQuery" xml:space="preserve">
    <value>SELECT
      [RecordingURL]
      ,[RecordingID]
  FROM [UN_Pabx].[dbo].[Rep_PABX_Daily_Logs]
  where CallID =@callid</value>
  </data>
  <data name="GetUserExtQuery" xml:space="preserve">
    <value>SELECT TOP (1) [ADUserID]
      ,[ID]
      ,[ID_Guid]
      ,[DisplayName]
      ,[GivenName]
      ,[Mail]
      ,[Surname]
      ,[UserPrincipalName]
      ,[Extension]
  FROM [ADUsers].[dbo].[ADUser]
  where [ID] = '{UserID}'</value>
  </data>
  <data name="TestCallQuery" xml:space="preserve">
    <value>SELECT *
FROM myphone_callhistory_v14 ch
ORDER BY ch.start_time DESC
limit 10</value>
